<?xml version="1.0" encoding="UTF-8" ?>
<XML ID="WebViewWindow">
    <FRAME item="WebViewFrame">
        <FRAMELOOK>DefaultFrameLook</FRAMELOOK>
        <BOUNDS>
            <X>0</X>
            <Y>0</Y>
            <W>780</W>
            <H>580</H>
        </BOUNDS>
        <ALIGN>
            <HALIGN>center</HALIGN>
            <VALIGN>center</VALIGN>
        </ALIGN>
        <VISIBLE>false</VISIBLE>
        <TEXT>GunZ Web Browser</TEXT>
    </FRAME>

    <PICTURE item="WebViewArea" parent="WebViewFrame">
